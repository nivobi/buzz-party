{
  "name": "buzz-party",
  "version": "1.0.0",
  "description": "Phones as Buzz! buzzers for the PS2 Buzz! games in PCSX2",
  "keywords": ["buzz", "buzzer", "pcsx2", "ps2", "party-game", "quiz", "electron", "emulation"],
  "homepage": "https://github.com/nivobi/buzz-party#readme",
  "bugs": "https://github.com/nivobi/buzz-party/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nivobi/buzz-party.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "build:helper": "mkdir -p build && swiftc -O native/mac/buzzhelper.swift -o build/buzzhelper",
    "build:helper:linux": "mkdir -p build && cc -O2 native/linux/buzzhelper.c -o build/buzzhelper",
    "dist": "npm run build:helper && npm run build && electron-builder --mac dir && node scripts/sign-mac.mjs",
    "dist:linux": "npm run build:helper:linux && npm run build && electron-builder --linux dir"
  },
  "author": "Nicolai Birk",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.22.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller": false
  },
  "private": true,
  "productName": "Buzz Party",
  "build": {
    "appId": "com.nivobi.buzzparty",
    "publish": null,
    "productName": "Buzz Party",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**",
      "web/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pcsx2",
        "to": "pcsx2"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Buzz Party keeps the game in front of other windows during play."
      },
      "extraResources": [
        {
          "from": "build/buzzhelper",
          "to": "buzzhelper"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "executableName": "buzz-party",
      "extraResources": [
        {
          "from": "build/buzzhelper",
          "to": "buzzhelper"
        }
      ]
    }
  }
}
