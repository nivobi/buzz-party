{
  "name": "buzz-party",
  "version": "1.0.0",
  "description": "Phones as Buzz! buzzers for PS2 Buzz! Junior games in PCSX2",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
